# Required. Never commit a real token.
BALE_TOKEN=

# Analysis admission: running workers plus bounded waiting queue.
MAX_FILE_MB=25
WORKERS=4
MAX_QUEUE=8
COOLDOWN_SEC=10
MAX_TEXT_CHARS=50000
# 0 means all findings that can be safely anchored in the source Word copy.
# A positive value (1..10000) is an optional operator limit.
# Remaining findings get qualified context comments on existing document text.
MAX_COMMENTS=0
# Only the latest HTML/TXT reports are retained in memory, per chat and sender.
REPORT_TTL_MINUTES=15
REPORT_CACHE_MB=32
# Experimental PDF marking remains off pending review in actual PDF readers.
PDF_ANNOTATION_EXPERIMENTAL=0

# Optional health server. Leave empty for local bot-only execution.
PORT=
HEALTH_STALE_SEC=120

# Optional transport overrides. HTTPS required except HTTP loopback.
BALE_API_BASE=https://tapi.bale.ai
# BALE_FILE_BASE=https://tapi.bale.ai/file

# Disabled unless explicitly configured by the operator.
KEEP_ALIVE_URL=

# Feedback from /feedback is appended here (no user IDs are stored).
# FEEDBACK_PATH=feedback.jsonl
# Bale chat ID of the bot owner; when set, each feedback message is also forwarded there.
ADMIN_CHAT_ID=

# Identical repeated mistakes beyond this many get only a yellow highlight; the first
# comment states the total. Keeps long theses openable in Word. 0 = comment every finding.
FOLD_REPEATED_COMMENTS=3
