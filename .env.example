# Required. Never commit a real token.
BALE_TOKEN=

# Analysis admission: running workers plus bounded waiting queue.
MAX_FILE_MB=25
WORKERS=4
MAX_QUEUE=8
COOLDOWN_SEC=10
MAX_TEXT_CHARS=50000

# Optional health server. Leave empty for local bot-only execution.
PORT=
HEALTH_STALE_SEC=120

# Optional transport overrides. HTTPS required except HTTP loopback.
BALE_API_BASE=https://tapi.bale.ai
# BALE_FILE_BASE=https://tapi.bale.ai/file

# Disabled unless explicitly configured by the operator.
KEEP_ALIVE_URL=
